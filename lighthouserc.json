{
  "ci": {
    "collect": {
      "startServerCommand": "node e2e/server.mjs",
      "startServerReadyPattern": "Static build on",
      "url": [
        "http://localhost:4300/",
        "http://localhost:4300/impressum/",
        "http://localhost:4300/datenschutz/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.95
          }
        ]
      }
    }
  }
}
