# Apache rules for the static build on All-Inkl (spec 3.3).
# The same file serves preview.philipp-klinger.com and philipp-klinger.com.
# e2e/server.mjs reads the Content-Security-Policy below, keep it on one line.
# It also reads the redirects with a local target, keep their format.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404/index.html
# The host sends plain text without a charset; llms.txt contains umlauts.
AddCharset utf-8 .txt

RewriteEngine On

# HTTPS only, then the domain without "www".
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# URLs of the legacy site.
RewriteRule ^imprint/?$ /impressum/ [R=301,L]
RewriteRule ^navigation/?$ / [R=301,L]
# The folder only exists through the project pages; NE keeps the "#" unescaped.
RewriteRule ^projekte/?$ /#projekte [R=301,NE,L]

# The CSR shell of the build is not part of the site.
RewriteRule ^index\.csr\.html$ - [R=404,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain application/xml text/xml
</IfModule>

<IfModule mod_headers.c>
  # Bundles and fonts carry a content hash in their name, so they never change.
  <FilesMatch "-[A-Z0-9]{8}\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Images keep their name when they change, so they are cached for 30 days only.
  <FilesMatch "\.(webp|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Inline styles come from Angular's component styles; scripts only from this server.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # The preview must not compete with the real site in search results.
  <If "%{HTTP_HOST} =~ /^preview\./">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>
